                                       Foreground="{StaticResource BuildCoreAccentBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Interface style"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="Choose the BuildCore accent color. The selection is saved and used throughout the interface."
                                       Foreground="#77777E"
                                       FontSize="9"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ACCENT COLOR"
                                               Foreground="#D8D8DD"
                                               FontSize="10"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="This changes BuildCore's primary highlight color without changing Windows."
                                               Foreground="#66666D"
                                               FontSize="8"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="AccentColorComboBox"
                                          Grid.Column="1"
                                          SelectedIndex="0"
                                          SelectionChanged="AccentColorComboBox_SelectionChanged"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Silver"/>
                                    <ComboBoxItem Content="White"/>
                                    <ComboBoxItem Content="Graphite"/>
                                </ComboBox>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Padding="20"
                            CornerRadius="14"
                            Background="#101014"
                            BorderBrush="#28282E"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="SAFETY"
                                       Foreground="{StaticResource BuildCoreAccentBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Optimization protection"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="These preferences affect how BuildCore handles potentially system-changing actions."
                                       Foreground="#77777E"
                                       FontSize="9"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,12"/>

                            <ToggleSwitch x:Name="ConfirmOptimizationToggle"
                                          Header="Confirm optimization changes"
                                          IsOn="True"
                                          OffContent="OFF"
                                          OnContent="ON"
                                          Toggled="ConfirmOptimizationToggle_Toggled"/>
                            <TextBlock Text="Keep confirmation dialogs enabled for system changes."
                                       Foreground="#66666D"
                                       FontSize="8"
                                       Margin="0,2,0,10"/>

                            <ToggleSwitch x:Name="AutoSnapshotToggle"
                                          Header="Create a safety snapshot before applying"
                                          IsOn="True"
                                          OffContent="OFF"
                                          OnContent="ON"
                                          Toggled="AutoSnapshotToggle_Toggled"/>
                            <TextBlock Text="Recommended. BuildCore should have a recovery point before supported changes."
                                       Foreground="#66666D"
                                       FontSize="8"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Padding="20"
                            CornerRadius="14"
                            Background="#101014"
                            BorderBrush="#28282E"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="INTERFACE"
                                       Foreground="{StaticResource BuildCoreAccentBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Application behavior"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0"/>

                            <ToggleSwitch x:Name="AnimationsToggle"
                                          Header="Interface animations"
                                          IsOn="True"
                                          OffContent="OFF"
                                          OnContent="ON"
                                          Toggled="AnimationsToggle_Toggled"
                                          Margin="0,12,0,0"/>
                            <TextBlock Text="Keeps future UI motion effects enabled. This does not change system performance settings."
                                       Foreground="#66666D"
                                       FontSize="8"
                                       Margin="0,2,0,10"/>

                            <ToggleSwitch x:Name="RememberPageToggle"
                                          Header="Remember last page"
                                          IsOn="False"
                                          OffContent="OFF"
                                          OnContent="ON"
                                          Toggled="RememberPageToggle_Toggled"/>
                            <TextBlock Text="Open the last BuildCore page instead of always starting on Dashboard."
                                       Foreground="#66666D"
                                       FontSize="8"
                                       Margin="0,2,0,0"/>

                            <ToggleSwitch x:Name="MinimizeToTrayToggle"
                                          Header="Keep BuildCore running in the hidden-icons area"
                                          IsOn="False"
                                          OffContent="OFF"
                                          OnContent="ON"
                                          Toggled="MinimizeToTrayToggle_Toggled"
                                          Margin="0,12,0,0"/>
                            <TextBlock Text="When enabled, closing the window hides BuildCore in the Windows hidden-icons area instead of exiting the app. Use the tray icon to reopen or exit."
                                       Foreground="#66666D"
                                       FontSize="8"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Padding="20"
                            CornerRadius="14"
                            Background="#101014"
                            BorderBrush="#28282E"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="MAINTENANCE"
                                       Foreground="{StaticResource BuildCoreAccentBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="BuildCore data"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="Reset appearance and interface preferences without deleting optimization snapshots or benchmark history."
                                       Foreground="#77777E"
                                       FontSize="9"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,12"/>
                            <Button x:Name="ResetSettingsButton"
                                    Content="RESET APP SETTINGS"
                                    Click="ResetSettingsButton_Click"
                                    HorizontalAlignment="Left"
                                    Padding="16,10"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,20"
                            Padding="18"
                            CornerRadius="12"
                            Background="#121216"
                            BorderBrush="#25252B"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="BUILDCORE"
                                       Foreground="White"
                                       FontSize="9"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Safe by design. BuildCore uses controlled optimization handlers rather than giving an assistant arbitrary access to Windows commands."
                                       Foreground="#77777E"
                                       FontSize="9"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>

    </Grid>

        </Grid>
    </Window>