<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BuildCore.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="BuildCore">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent" RequestedTheme="Dark">
        <Grid.Resources>
            <SolidColorBrush x:Key="BuildCoreAccentBrush" Color="#D8D8DE"/>
            <SolidColorBrush x:Key="BuildCorePanelBrush" Color="#111116"/>
            <SolidColorBrush x:Key="BuildCoreBorderBrush" Color="#29292F"/>
            <SolidColorBrush x:Key="BuildCorePrimaryTextBrush" Color="#EEEEF1"/>
            <SolidColorBrush x:Key="BuildCoreMutedTextBrush" Color="#85858D"/>

            <!-- Shared monochrome default for controls that do not define their own appearance. -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="#17171C"/>
                <Setter Property="Foreground" Value="#EEEEF1"/>
                <Setter Property="BorderBrush" Value="#303036"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="6"/>
            </Style>
        </Grid.Resources>
        <!-- Subtle cinematic space layer. Kept behind all interactive UI. -->
        <Canvas
            Grid.ColumnSpan="2"
            IsHitTestVisible="False"
            Opacity="0.72">

            <Ellipse
                x:Name="ParallaxGlowOne"
                Width="620"
                Height="620"
                Canvas.Left="-180"
                Canvas.Top="120"
                Fill="#151519"
                Opacity="0.9"/>

            <Ellipse
                x:Name="ParallaxGlowTwo"
                Width="520"
                Height="520"
                Canvas.Left="760"
                Canvas.Top="520"
                Fill="#111116"
                Opacity="0.85"/>

            <Ellipse
                x:Name="ParallaxRingOne"
                Width="760"
                Height="760"
                Canvas.Left="980"
                Canvas.Top="-160"
                Stroke="#FFFFFF"
                StrokeThickness="1"
                Opacity="0.055"/>

            <Ellipse
                x:Name="ParallaxRingTwo"
                Width="980"
                Height="980"
                Canvas.Left="220"
                Canvas.Top="360"
                Stroke="#FFFFFF"
                StrokeThickness="1"
                Opacity="0.035"/>

            <Ellipse
                Width="3"
                Height="3"
                Canvas.Left="18"
                Canvas.Top="110"
                Fill="White"
                Opacity="0.45"/>

            <Ellipse
                Width="2"
                Height="2"
                Canvas.Left="88"
                Canvas.Top="410"
                Fill="White"
                Opacity="0.35"/>

            <Ellipse
                Width="2"
                Height="2"
                Canvas.Left="340"
                Canvas.Top="170"
                Fill="White"
                Opacity="0.3"/>

            <Ellipse
                Width="2"
                Height="2"
                Canvas.Left="610"
                Canvas.Top="90"
                Fill="White"
                Opacity="0.3"/>

            <Ellipse
                Width="3"
                Height="3"
                Canvas.Left="820"
                Canvas.Top="230"
                Fill="White"
                Opacity="0.4"/>

            <Ellipse
                Width="2"
                Height="2"
                Canvas.Left="1160"
                Canvas.Top="150"
                Fill="White"
                Opacity="0.35"/>

            <Ellipse
                Width="2"
                Height="2"
                Canvas.Left="1320"
                Canvas.Top="520"
                Fill="White"
                Opacity="0.3"/>

        </Canvas>

        <Grid x:Name="BuildCoreContentRoot">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ====================================================== -->
        <!-- SIDEBAR -->
        <!-- ====================================================== -->

        <Border
            Grid.Column="0"
            Background="#0D0D10"
            BorderBrush="#202024"
            BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="110"/>
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="24,0,0,0">

                    <Border
                        Width="42"
                        Height="42"
                        CornerRadius="10"
                        Background="White">

                        <TextBlock
                            Text="B"
                            Foreground="#09090B"
                            FontSize="24"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="BUILDCORE"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="PC PERFORMANCE"
                            Foreground="#66666D"
                            FontSize="8"
                            Margin="0,3,0,0"/>

                    </StackPanel>

                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Margin="14,20,14,0">

                    <Button
                        x:Name="DashboardButton"
                        Click="DashboardButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="⌂"
                                FontSize="17"
                                Foreground="#AAAAAF"
                                Width="28"/>

                            <TextBlock
                                Text="Dashboard"
                                Foreground="#DADADF"
                                FontSize="13"/>

                        </StackPanel>

                    </Button>

                    <Button
                        x:Name="SystemButton"
                        Click="SystemButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="▣"
                                FontSize="15"
                                Foreground="#AAAAAF"
                                Width="28"/>

                            <TextBlock
                                Text="System"
                                Foreground="#DADADF"
                                FontSize="13"/>

                        </StackPanel>

                    </Button>

                    <Button
                        x:Name="PerformanceButton"
                        Click="PerformanceButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="◌"
                                FontSize="17"
                                Foreground="#AAAAAF"
                                Width="28"/>

                            <TextBlock
                                Text="Performance"
                                Foreground="#DADADF"
                                FontSize="13"/>

                        </StackPanel>

                    </Button>

                    <Button
                        x:Name="OptimizeButton"
                        Click="OptimizeButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="⚡"
                                FontSize="15"
                                Foreground="White"
                                Width="28"/>

                            <TextBlock
                                Text="Optimize"
                                Foreground="White"
                                FontSize="13"
                                FontWeight="SemiBold"/>

                        </StackPanel>

                    </Button>

                    <Button
                        x:Name="AutoTuneButton"
                        Click="AutoTuneButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✦" FontSize="16" Foreground="#AAAAAF" Width="28"/>
                            <TextBlock Text="AutoTune" Foreground="#DADADF" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="HistoryButton"
                        Click="HistoryButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="◷"
                                FontSize="16"
                                Foreground="#AAAAAF"
                                Width="28"/>

                            <TextBlock
                                Text="History"
                                Foreground="#DADADF"
                                FontSize="13"/>

                        </StackPanel>

                    </Button>

                    <Button
                        x:Name="SettingsButton"
                        Click="SettingsButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="⚙"
                                FontSize="16"
                                Foreground="#AAAAAF"
                                Width="28"/>

                            <TextBlock
                                Text="Settings"
                                Foreground="#DADADF"
                                FontSize="13"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

                <Border
                    Grid.Row="2"
                    Margin="16,10,16,18"
                    Padding="14"
                    CornerRadius="10"
                    Background="#121216">

                    <StackPanel>

                        <StackPanel
                            Orientation="Horizontal">

                            <Ellipse
                                Width="7"
                                Height="7"
                                Fill="#D8D8DE"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Text=" SYSTEM PROTECTED"
                                Foreground="#D8D8DD"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Margin="5,0,0,0"/>

                        </StackPanel>

                        <TextBlock
                            Text="Snapshots enabled"
                            Foreground="#66666D"
                            FontSize="9"
                            Margin="0,7,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- ====================================================== -->
        <!-- MAIN -->
        <!-- ====================================================== -->

        <Grid
            Grid.Column="1">

            <Border
                Height="64"
                VerticalAlignment="Top"
                Background="#0B0B0E"
                BorderBrush="#202024"
                BorderThickness="0,0,0,1">

                <Grid>

                    <TextBlock
                        Text="BuildCore"
                        Foreground="#77777E"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Margin="28,0,0,0"/>

                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Margin="0,0,28,0"
                        VerticalAlignment="Center">

                        <Ellipse
                            Width="7"
                            Height="7"
                            Fill="#D8D8DE"/>

                        <TextBlock
                            Text=" SYSTEM ONLINE"
                            Foreground="#AFAFB5"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Margin="6,0,0,0"/>

                        <TextBlock
                            x:Name="PageTitleText"
                            Text="Dashboard"
                            Foreground="#55555C"
                            FontSize="9"
                            Margin="25,0,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- ================================================== -->
            <!-- DASHBOARD -->
            <!-- ================================================== -->

            <Grid x:Name="DashboardPage" Margin="0,64,0,0" Background="#030305">
                <Grid x:Name="DashboardSpaceRoot" SizeChanged="DashboardSpaceRoot_SizeChanged">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#020204" Offset="0"/>
                            <GradientStop Color="#0A0A0D" Offset="0.55"/>
                            <GradientStop Color="#030305" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!-- Monochrome deep-space stars -->
                    <Canvas IsHitTestVisible="False" Opacity="0.7">
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="48" Canvas.Top="62" Opacity="0.65"/>
                        <Ellipse Width="3" Height="3" Fill="White" Canvas.Left="162" Canvas.Top="188" Opacity="0.45"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="284" Canvas.Top="90" Opacity="0.55"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="418" Canvas.Top="262" Opacity="0.5"/>
                        <Ellipse Width="3" Height="3" Fill="White" Canvas.Left="582" Canvas.Top="80" Opacity="0.6"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="742" Canvas.Top="170" Opacity="0.45"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="884" Canvas.Top="62" Opacity="0.55"/>
                        <Ellipse Width="3" Height="3" Fill="White" Canvas.Left="1082" Canvas.Top="224" Opacity="0.45"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="1194" Canvas.Top="102" Opacity="0.6"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="95" Canvas.Top="470" Opacity="0.45"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="326" Canvas.Top="622" Opacity="0.55"/>
                        <Ellipse Width="3" Height="3" Fill="White" Canvas.Left="520" Canvas.Top="548" Opacity="0.4"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="812" Canvas.Top="644" Opacity="0.55"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="1034" Canvas.Top="520" Opacity="0.45"/>
                        <Ellipse Width="3" Height="3" Fill="White" Canvas.Left="1198" Canvas.Top="680" Opacity="0.5"/>
                    </Canvas>

                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,24,0,0" IsHitTestVisible="False">
                        <TextBlock Text="SYSTEM COMMAND CENTER" Foreground="#A6A6AD" FontSize="10" FontWeight="SemiBold" CharacterSpacing="180"/>
                        <TextBlock Text="Navigate your system" Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/>
                        <TextBlock Text="Select a planet to open a BuildCore module" Foreground="#77777F" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Orbital tracks and monochrome planetary navigation -->
                    <Canvas x:Name="PlanetaryCanvas" Width="1200" Height="700" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Ellipse Width="430" Height="220" Canvas.Left="385" Canvas.Top="240" Stroke="#4CFFFFFF" StrokeThickness="1" Opacity="0.55"/>
                        <Ellipse Width="610" Height="320" Canvas.Left="295" Canvas.Top="190" Stroke="#38FFFFFF" StrokeThickness="1" Opacity="0.65"/>
                        <Ellipse Width="790" Height="420" Canvas.Left="205" Canvas.Top="140" Stroke="#30FFFFFF" StrokeThickness="1" Opacity="0.65"/>
                        <Ellipse Width="970" Height="520" Canvas.Left="115" Canvas.Top="90" Stroke="#28FFFFFF" StrokeThickness="1" Opacity="0.7"/>
                        <Ellipse Width="1130" Height="610" Canvas.Left="35" Canvas.Top="45" Stroke="#20FFFFFF" StrokeThickness="1" Opacity="0.8"/>

                        <!-- Core Sun -->
                        <Grid Canvas.Left="522" Canvas.Top="278" Width="156" Height="156" IsHitTestVisible="False">
                            <Ellipse Width="156" Height="156" Fill="#18FFFFFF"/>
                            <Ellipse Width="136" Height="136" Margin="10" Fill="#36FFFFFF"/>
                            <Ellipse Width="118" Height="118" Margin="19">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.35,0.32" RadiusX="0.78" RadiusY="0.78">
                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                        <GradientStop Color="#FFE3E3E3" Offset="0.18"/>
                                        <GradientStop Color="#FF8C8C8C" Offset="0.42"/>
                                        <GradientStop Color="#FF292929" Offset="0.72"/>
                                        <GradientStop Color="#FF050505" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                        <GradientStop Color="#FF777777" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                                <Ellipse.StrokeThickness>1.5</Ellipse.StrokeThickness>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="BUILDCORE" Canvas.Left="555" Canvas.Top="440" Foreground="White" FontSize="16" FontWeight="Bold" CharacterSpacing="70"/>
                        <TextBlock Text="SYSTEM OPTIMIZER" Canvas.Left="559" Canvas.Top="463" Foreground="#85858B" FontSize="8" CharacterSpacing="170"/>

                        <!-- Dashboard -->
                        <Button Canvas.Left="135" Canvas.Top="292" Width="118" Height="145" Background="Transparent" BorderThickness="0" Padding="0" Click="DashboardButton_Click" PointerEntered="PlanetButton_PointerEntered" PointerExited="PlanetButton_PointerExited" ToolTipService.ToolTip="Dashboard — overview, health and temperatures">
                            <StackPanel HorizontalAlignment="Center" Spacing="9">
                                <Grid Width="70" Height="70">
                                    <Ellipse Width="70" Height="70" Stroke="#AFAFAF" StrokeThickness="0.7">
                                    <Ellipse.Fill><RadialGradientBrush Center="0.28,0.25" RadiusX="0.8" RadiusY="0.8"><GradientStop Color="#FFF7F7F7" Offset="0"/><GradientStop Color="#FF858585" Offset="0.25"/><GradientStop Color="#FF292929" Offset="0.62"/><GradientStop Color="#FF030303" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                                </Ellipse>
                                    <Ellipse Width="13" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,22,0,0" Fill="#26000000" Stroke="#55FFFFFF" StrokeThickness="0.55" Opacity="0.8"/>
                                    <Ellipse Width="8" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="43,41,0,0" Fill="#24000000" Stroke="#42FFFFFF" StrokeThickness="0.45" Opacity="0.75"/>
                                </Grid>
                                <TextBlock Text="DASHBOARD" Foreground="White" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Overview · Health · Temps" Foreground="#A3A3AA" FontSize="8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- System -->
                        <Button Canvas.Left="280" Canvas.Top="92" Width="132" Height="145" Background="Transparent" BorderThickness="0" Padding="0" Click="SystemButton_Click" PointerEntered="PlanetButton_PointerEntered" PointerExited="PlanetButton_PointerExited" ToolTipService.ToolTip="System — hardware and Windows details">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <Grid Width="88" Height="88">
                                    <Ellipse Width="88" Height="88" Stroke="#AFAFAF" StrokeThickness="0.7">
                                    <Ellipse.Fill><RadialGradientBrush Center="0.28,0.22" RadiusX="0.8" RadiusY="0.8"><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#FFBEBEBE" Offset="0.2"/><GradientStop Color="#FF565656" Offset="0.48"/><GradientStop Color="#FF151515" Offset="0.8"/><GradientStop Color="#FF030303" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                                </Ellipse>
                                    <Ellipse Width="17" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,27,0,0" Fill="#26000000" Stroke="#55FFFFFF" StrokeThickness="0.55" Opacity="0.8"/>
                                    <Ellipse Width="11" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="54,52,0,0" Fill="#24000000" Stroke="#42FFFFFF" StrokeThickness="0.45" Opacity="0.75"/>
                                </Grid>
                                <TextBlock Text="SYSTEM" Foreground="White" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Hardware &amp; OS" Foreground="#A3A3AA" FontSize="8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Performance -->
                        <Button Canvas.Left="570" Canvas.Top="72" Width="116" Height="126" Background="Transparent" BorderThickness="0" Padding="0" Click="PerformanceButton_Click" PointerEntered="PlanetButton_PointerEntered" PointerExited="PlanetButton_PointerExited" ToolTipService.ToolTip="Performance — FPS, latency and benchmarks">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <Grid Width="62" Height="62">
                                    <Ellipse Width="62" Height="62" Stroke="#BFBFBF" StrokeThickness="0.7">
                                    <Ellipse.Fill><RadialGradientBrush Center="0.25,0.22" RadiusX="0.8" RadiusY="0.8"><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#FF999999" Offset="0.25"/><GradientStop Color="#FF3C3C3C" Offset="0.65"/><GradientStop Color="#FF020202" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                                </Ellipse>
                                    <Ellipse Width="12" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,19,0,0" Fill="#26000000" Stroke="#55FFFFFF" StrokeThickness="0.55" Opacity="0.8"/>
                                    <Ellipse Width="7" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="38,37,0,0" Fill="#24000000" Stroke="#42FFFFFF" StrokeThickness="0.45" Opacity="0.75"/>
                                </Grid>
                                <TextBlock Text="PERFORMANCE" Foreground="White" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="FPS · Latency · Benchmarks" Foreground="#A3A3AA" FontSize="8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Optimize -->
                        <Button Canvas.Left="890" Canvas.Top="145" Width="170" Height="190" Background="Transparent" BorderThickness="0" Padding="0" Click="OptimizeButton_Click" PointerEntered="PlanetButton_PointerEntered" PointerExited="PlanetButton_PointerExited" ToolTipService.ToolTip="Optimize — tweaks, settings and recovery">
                            <StackPanel HorizontalAlignment="Center" Spacing="9">
                                <Grid Width="150" Height="150">
                                    <Ellipse Width="150" Height="150" Stroke="#BFBFBF" StrokeThickness="0.7">
                                    <Ellipse.Fill><RadialGradientBrush Center="0.25,0.22" RadiusX="0.82" RadiusY="0.82"><GradientStop Color="#FFFDFDFD" Offset="0"/><GradientStop Color="#FFB8B8B8" Offset="0.15"/><GradientStop Color="#FF5C5C5C" Offset="0.35"/><GradientStop Color="#FF171717" Offset="0.7"/><GradientStop Color="#FF020202" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                                </Ellipse>
                                    <Ellipse Width="29" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="35,47,0,0" Fill="#26000000" Stroke="#55FFFFFF" StrokeThickness="0.55" Opacity="0.8"/>
                                    <Ellipse Width="18" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="92,89,0,0" Fill="#24000000" Stroke="#42FFFFFF" StrokeThickness="0.45" Opacity="0.75"/>
                                </Grid>
                                <TextBlock Text="OPTIMIZE" Foreground="White" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Tweaks · Settings · Recovery" Foreground="#A3A3AA" FontSize="8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- AutoTune -->
                        <Button Canvas.Left="905" Canvas.Top="425" Width="142" Height="148" Background="Transparent" BorderThickness="0" Padding="0" Click="AutoTuneButton_Click" PointerEntered="PlanetButton_PointerEntered" PointerExited="PlanetButton_PointerExited" ToolTipService.ToolTip="AutoTune — guided optimization and undo">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <Grid Width="82" Height="82">
                                    <Ellipse Width="82" Height="82" Stroke="#BFBFBF" StrokeThickness="0.7">
                                    <Ellipse.Fill><RadialGradientBrush Center="0.25,0.2" RadiusX="0.8" RadiusY="0.8"><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#FFBDBDBD" Offset="0.24"/><GradientStop Color="#FF454545" Offset="0.6"/><GradientStop Color="#FF030303" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                                </Ellipse>
                                    <Ellipse Width="16" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="19,25,0,0" Fill="#26000000" Stroke="#55FFFFFF" StrokeThickness="0.55" Opacity="0.8"/>
                                    <Ellipse Width="10" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="50,48,0,0" Fill="#24000000" Stroke="#42FFFFFF" StrokeThickness="0.45" Opacity="0.75"/>
                                </Grid>
                                <TextBlock Text="AUTOTUNE" Foreground="White" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="AI Assistant · Apply · Undo" Foreground="#A3A3AA" FontSize="8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- History -->
                        <Button Canvas.Left="215" Canvas.Top="475" Width="180" Height="170" Background="Transparent" BorderThickness="0" Padding="0" Click="HistoryButton_Click" PointerEntered="PlanetButton_PointerEntered" PointerExited="PlanetButton_PointerExited" ToolTipService.ToolTip="History — logs, benchmarks and activity">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <Grid Width="120" Height="120">
                                    <Ellipse Width="120" Height="120" Stroke="#BFBFBF" StrokeThickness="0.7">
