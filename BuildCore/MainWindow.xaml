<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BuildCore.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="BuildCore">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.Resources>
            <SolidColorBrush x:Key="BuildCoreAccentBrush" Color="#DADAE0"/>
        </Grid.Resources>
        <!-- Subtle cinematic space layer. Kept behind all interactive UI. -->
        <Canvas
            Grid.ColumnSpan="2"
            IsHitTestVisible="False"
            Opacity="0.72">

            <Ellipse
                x:Name="ParallaxGlowOne"
                Width="620"
                Height="620"
                Canvas.Left="-180"
                Canvas.Top="120"
                Fill="#151519"
                Opacity="0.9"/>

            <Ellipse
                x:Name="ParallaxGlowTwo"
                Width="520"
                Height="520"
                Canvas.Left="760"
                Canvas.Top="520"
                Fill="#111116"
                Opacity="0.85"/>

            <Ellipse
                x:Name="ParallaxRingOne"
                Width="760"
                Height="760"
                Canvas.Left="980"
                Canvas.Top="-160"
                Stroke="#FFFFFF"
                StrokeThickness="1"
                Opacity="0.055"/>

            <Ellipse
                x:Name="ParallaxRingTwo"
                Width="980"
                Height="980"
                Canvas.Left="220"
                Canvas.Top="360"
                Stroke="#FFFFFF"
                StrokeThickness="1"
                Opacity="0.035"/>

            <Ellipse
                Width="3"
                Height="3"
                Canvas.Left="18"
                Canvas.Top="110"
                Fill="White"
                Opacity="0.45"/>

            <Ellipse
                Width="2"
                Height="2"
                Canvas.Left="88"
                Canvas.Top="410"
                Fill="White"
                Opacity="0.35"/>

            <Ellipse
                Width="2"
                Height="2"
                Canvas.Left="340"
                Canvas.Top="170"
                Fill="White"
                Opacity="0.3"/>

            <Ellipse
                Width="2"
                Height="2"
                Canvas.Left="610"
                Canvas.Top="90"
                Fill="White"
                Opacity="0.3"/>

            <Ellipse
                Width="3"
                Height="3"
                Canvas.Left="820"
                Canvas.Top="230"
                Fill="White"
                Opacity="0.4"/>

            <Ellipse
                Width="2"
                Height="2"
                Canvas.Left="1160"
                Canvas.Top="150"
                Fill="White"
                Opacity="0.35"/>

            <Ellipse
                Width="2"
                Height="2"
                Canvas.Left="1320"
                Canvas.Top="520"
                Fill="White"
                Opacity="0.3"/>

        </Canvas>

        <Grid x:Name="BuildCoreContentRoot">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ====================================================== -->
        <!-- SIDEBAR -->
        <!-- ====================================================== -->

        <Border
            Grid.Column="0"
            Visibility="Collapsed"
            Background="#0D0D10"
            BorderBrush="#202024"
            BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="110"/>
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="24,0,0,0">

                    <Border
                        Width="42"
                        Height="42"
                        CornerRadius="10"
                        Background="White">

                        <TextBlock
                            Text="B"
                            Foreground="#09090B"
                            FontSize="24"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="BUILDCORE"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="PC PERFORMANCE"
                            Foreground="#66666D"
                            FontSize="8"
                            Margin="0,3,0,0"/>

                    </StackPanel>

                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Margin="14,20,14,0">

                    <Button
                        x:Name="DashboardButton"
                        Click="DashboardButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="⌂"
                                FontSize="17"
                                Foreground="#AAAAAF"
                                Width="28"/>

                            <TextBlock
                                Text="Dashboard"
                                Foreground="#DADADF"
                                FontSize="13"/>

                        </StackPanel>

                    </Button>

                    <Button
                        x:Name="SystemButton"
                        Click="SystemButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="▣"
                                FontSize="15"
                                Foreground="#AAAAAF"
                                Width="28"/>

                            <TextBlock
                                Text="System"
                                Foreground="#DADADF"
                                FontSize="13"/>

                        </StackPanel>

                    </Button>

                    <Button
                        x:Name="PerformanceButton"
                        Click="PerformanceButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="◌"
                                FontSize="17"
                                Foreground="#AAAAAF"
                                Width="28"/>

                            <TextBlock
                                Text="Performance"
                                Foreground="#DADADF"
                                FontSize="13"/>

                        </StackPanel>

                    </Button>

                    <Button
                        x:Name="OptimizeButton"
                        Click="OptimizeButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="#17171C"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="⚡"
                                FontSize="15"
                                Foreground="White"
                                Width="28"/>

                            <TextBlock
                                Text="Optimize"
                                Foreground="White"
                                FontSize="13"
                                FontWeight="SemiBold"/>

                        </StackPanel>

                    </Button>

                    <Button
                        x:Name="AutoTuneButton"
                        Click="AutoTuneButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✦" FontSize="16" Foreground="#AAAAAF" Width="28"/>
                            <TextBlock Text="AutoTune" Foreground="#DADADF" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="HistoryButton"
                        Click="HistoryButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="◷"
                                FontSize="16"
                                Foreground="#AAAAAF"
                                Width="28"/>

                            <TextBlock
                                Text="History"
                                Foreground="#DADADF"
                                FontSize="13"/>

                        </StackPanel>

                    </Button>

                    <Button
                        x:Name="SettingsButton"
                        Click="SettingsButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="⚙"
                                FontSize="16"
                                Foreground="#AAAAAF"
                                Width="28"/>

                            <TextBlock
                                Text="Settings"
                                Foreground="#DADADF"
                                FontSize="13"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

                <Border
                    Grid.Row="2"
                    Margin="16,10,16,18"
                    Padding="14"
                    CornerRadius="10"
                    Background="#121216">

                    <StackPanel>

                        <StackPanel
                            Orientation="Horizontal">

                            <Ellipse
                                Width="7"
                                Height="7"
                                Fill="#DADAE0"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Text=" SYSTEM PROTECTED"
                                Foreground="#D8D8DD"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Margin="5,0,0,0"/>

                        </StackPanel>

                        <TextBlock
                            Text="Snapshots enabled"
                            Foreground="#66666D"
                            FontSize="9"
                            Margin="0,7,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- ====================================================== -->
        <!-- MAIN -->
        <!-- ====================================================== -->

        <Grid
            Grid.Column="1">

            <Border
                Height="64"
                VerticalAlignment="Top"
                Background="#0B0B0E"
                BorderBrush="#202024"
                BorderThickness="0,0,0,1">

                <Grid>

                    <Button
                        Content="←  SOLAR SYSTEM"
                        Click="DashboardButton_Click"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="20,0,0,0"
                        Padding="12,8"
                        Background="#111116"
                        Foreground="#D8D8DE"
                        BorderBrush="#303036"
                        BorderThickness="1"
                        FontSize="10"
                        FontWeight="SemiBold"
                        ToolTipService.ToolTip="Return to the solar-system menu"/>

                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Margin="0,0,28,0"
                        VerticalAlignment="Center">

                        <Ellipse
                            Width="7"
                            Height="7"
                            Fill="#DADAE0"/>

                        <TextBlock
                            Text=" SYSTEM ONLINE"
                            Foreground="#AFAFB5"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Margin="6,0,0,0"/>

                        <TextBlock
                            x:Name="PageTitleText"
                            Text="Dashboard"
                            Foreground="#55555C"
                            FontSize="9"
                            Margin="25,0,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- ================================================== -->
            <!-- DASHBOARD -->
            <!-- ================================================== -->

            <Grid x:Name="DashboardPage" Margin="0,64,0,0" Background="#030305">
                <Grid x:Name="DashboardSpaceRoot" SizeChanged="DashboardSpaceRoot_SizeChanged">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#020204" Offset="0"/>
                            <GradientStop Color="#0A0A0D" Offset="0.55"/>
                            <GradientStop Color="#030305" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!-- NASA Goddard TESS southern-sky photograph. A dark overlay keeps the
                         real star field atmospheric while preserving readable navigation labels.
                         The procedural stars and gradients below remain as a fallback layer. -->
                    <Image
                        Source="https://svs.gsfc.nasa.gov/vis/a000000/a004800/a004851/milkyway_2020_4k_print.jpg"
                        Stretch="UniformToFill"
                        Opacity="0.26"
                        IsHitTestVisible="False"/>

                    <Border IsHitTestVisible="False" Background="#8C020205"/>

                    <!-- Monochrome deep-space stars -->
                    <Canvas IsHitTestVisible="False" Opacity="0.7">
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="48" Canvas.Top="62" Opacity="0.65"/>
                        <Ellipse Width="3" Height="3" Fill="White" Canvas.Left="162" Canvas.Top="188" Opacity="0.45"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="284" Canvas.Top="90" Opacity="0.55"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="418" Canvas.Top="262" Opacity="0.5"/>
                        <Ellipse Width="3" Height="3" Fill="White" Canvas.Left="582" Canvas.Top="80" Opacity="0.6"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="742" Canvas.Top="170" Opacity="0.45"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="884" Canvas.Top="62" Opacity="0.55"/>
                        <Ellipse Width="3" Height="3" Fill="White" Canvas.Left="1082" Canvas.Top="224" Opacity="0.45"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="1194" Canvas.Top="102" Opacity="0.6"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="95" Canvas.Top="470" Opacity="0.45"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="326" Canvas.Top="622" Opacity="0.55"/>
                        <Ellipse Width="3" Height="3" Fill="White" Canvas.Left="520" Canvas.Top="548" Opacity="0.4"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="812" Canvas.Top="644" Opacity="0.55"/>
                        <Ellipse Width="2" Height="2" Fill="White" Canvas.Left="1034" Canvas.Top="520" Opacity="0.45"/>
                        <Ellipse Width="3" Height="3" Fill="White" Canvas.Left="1198" Canvas.Top="680" Opacity="0.5"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="72" Canvas.Top="124" Opacity="0.38"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="218" Canvas.Top="42" Opacity="0.32"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="352" Canvas.Top="152" Opacity="0.35"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="476" Canvas.Top="54" Opacity="0.3"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="532" Canvas.Top="210" Opacity="0.34"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="672" Canvas.Top="38" Opacity="0.4"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="816" Canvas.Top="102" Opacity="0.32"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="954" Canvas.Top="142" Opacity="0.36"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="1138" Canvas.Top="78" Opacity="0.3"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="1164" Canvas.Top="338" Opacity="0.34"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="58" Canvas.Top="318" Opacity="0.3"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="206" Canvas.Top="386" Opacity="0.34"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="382" Canvas.Top="344" Opacity="0.3"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="470" Canvas.Top="448" Opacity="0.32"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="566" Canvas.Top="620" Opacity="0.35"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="702" Canvas.Top="498" Opacity="0.32"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="774" Canvas.Top="588" Opacity="0.3"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="934" Canvas.Top="382" Opacity="0.35"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="1092" Canvas.Top="612" Opacity="0.32"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="1144" Canvas.Top="468" Opacity="0.3"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="140" Canvas.Top="568" Opacity="0.34"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="260" Canvas.Top="250" Opacity="0.3"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="342" Canvas.Top="540" Opacity="0.32"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="488" Canvas.Top="162" Opacity="0.3"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="628" Canvas.Top="126" Opacity="0.34"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="748" Canvas.Top="278" Opacity="0.3"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="860" Canvas.Top="228" Opacity="0.32"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="1004" Canvas.Top="292" Opacity="0.3"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="1064" Canvas.Top="182" Opacity="0.32"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="42" Canvas.Top="220" Opacity="0.3"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="184" Canvas.Top="112" Opacity="0.3"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="314" Canvas.Top="44" Opacity="0.32"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="426" Canvas.Top="584" Opacity="0.3"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="642" Canvas.Top="666" Opacity="0.3"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="844" Canvas.Top="660" Opacity="0.32"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="988" Canvas.Top="560" Opacity="0.3"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="1172" Canvas.Top="584" Opacity="0.32"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="524" Canvas.Top="350" Opacity="0.3"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="786" Canvas.Top="414" Opacity="0.3"/>
                        <Ellipse Width="1" Height="1" Fill="#FFF" Canvas.Left="108" Canvas.Top="660" Opacity="0.3"/>
                    </Canvas>

                    <!-- Subtle cinematic vignette: keeps the planets as the focal point
                         while allowing the outer edges of the scene to fall into black. -->
                    <Border IsHitTestVisible="False" Opacity="0.62">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.46" RadiusX="0.72" RadiusY="0.78">
                                <GradientStop Color="#00000000" Offset="0.42"/>
                                <GradientStop Color="#18000000" Offset="0.68"/>
                                <GradientStop Color="#B8000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,24,0,0" IsHitTestVisible="False">
                        <TextBlock Text="SYSTEM COMMAND CENTER" Foreground="#A6A6AD" FontSize="10" FontWeight="SemiBold" CharacterSpacing="180"/>
                        <TextBlock Text="Navigate your system" Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/>
                        <TextBlock Text="Select a planet to open a BuildCore module" Foreground="#77777F" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Orbital tracks and monochrome planetary navigation -->
                    <Canvas x:Name="PlanetaryCanvas" Width="1200" Height="700" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Ellipse Width="430" Height="220" Canvas.Left="385" Canvas.Top="240" Stroke="#4CFFFFFF" StrokeThickness="1" Opacity="0.55"/>
                        <Ellipse Width="610" Height="320" Canvas.Left="295" Canvas.Top="190" Stroke="#38FFFFFF" StrokeThickness="1" Opacity="0.65"/>
                        <Ellipse Width="790" Height="420" Canvas.Left="205" Canvas.Top="140" Stroke="#30FFFFFF" StrokeThickness="1" Opacity="0.65"/>
                        <Ellipse Width="970" Height="520" Canvas.Left="115" Canvas.Top="90" Stroke="#28FFFFFF" StrokeThickness="1" Opacity="0.7"/>
                        <Ellipse Width="1130" Height="610" Canvas.Left="35" Canvas.Top="45" Stroke="#20FFFFFF" StrokeThickness="1" Opacity="0.8"/>

                        <!-- Central Sun: layered corona, bright photosphere and subtle surface granulation -->
                        <Grid Canvas.Left="492" Canvas.Top="248" Width="216" Height="216" IsHitTestVisible="False">
                            <Ellipse Width="216" Height="216">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#00FFFFFF" Offset="0.40"/>
                                        <GradientStop Color="#12E8E8E8" Offset="0.58"/>
                                        <GradientStop Color="#28DADADA" Offset="0.72"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="178" Height="178" Margin="19">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#35FFFFFF" Offset="0.50"/>
                                        <GradientStop Color="#4FFFFFFF" Offset="0.72"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="148" Height="148" Margin="34" Fill="#30FFFFFF"/>
                            <Ellipse Width="126" Height="126" Margin="45">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="0.37,0.32" RadiusX="0.78" RadiusY="0.78">
                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                        <GradientStop Color="#FFF1F1F1" Offset="0.20"/>
                                        <GradientStop Color="#FFBDBDBD" Offset="0.42"/>
                                        <GradientStop Color="#FF777777" Offset="0.68"/>
                                        <GradientStop Color="#FF222222" Offset="0.91"/>
                                        <GradientStop Color="#FF080808" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                        <GradientStop Color="#FF777777" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                                <Ellipse.StrokeThickness>1.2</Ellipse.StrokeThickness>
                            </Ellipse>
                            <Ellipse Width="39" Height="12" Margin="51,56,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#18FFFFFF" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform Angle="-24"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="28" Height="8" Margin="92,87,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#22FFFFFF" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform Angle="31"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse Width="22" Height="7" Margin="69,111,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#18FFFFFF" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><RotateTransform Angle="-12"/></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="BUILDCORE" Canvas.Left="555" Canvas.Top="440" Foreground="White" FontSize="16" FontWeight="Bold" CharacterSpacing="70"/>
                        <TextBlock Text="SYSTEM OPTIMIZER" Canvas.Left="559" Canvas.Top="463" Foreground="#85858B" FontSize="8" CharacterSpacing="170"/>

                        <!-- Dashboard -->
                        <Button Canvas.Left="135" Canvas.Top="292" Width="118" Height="145" Background="Transparent" BorderThickness="0" Padding="0" Click="PlanetDashboard_Click" PointerEntered="PlanetButton_PointerEntered" PointerExited="PlanetButton_PointerExited" ToolTipService.ToolTip="Dashboard — overview, health and temperatures">
                            <StackPanel HorizontalAlignment="Center" Spacing="9">
                                <Grid Width="70" Height="70">
<Ellipse Width="86" Height="86" Fill="#18FFFFFF" Opacity="0" IsHitTestVisible="False"/>
                                                                        <Ellipse Width="70" Height="70" Stroke="#AFAFAF" StrokeThickness="0.7">
                                    <Ellipse.Fill><ImageBrush ImageSource="https://www.solarsystemscope.com/textures/download/2k_mars.jpg" Stretch="UniformToFill"/></Ellipse.Fill>
                                </Ellipse>
