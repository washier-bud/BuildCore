                                       Foreground="#66666D"
                                       FontSize="8"
                                       Margin="0,2,0,10"/>

                            <ToggleSwitch x:Name="RememberPageToggle"
                                          Header="Remember last page"
                                          IsOn="False"
                                          OffContent="OFF"
                                          OnContent="ON"
                                          Toggled="RememberPageToggle_Toggled"/>
                            <TextBlock Text="Open the last BuildCore page instead of always starting on Dashboard."
                                       Foreground="#66666D"
                                       FontSize="8"
                                       Margin="0,2,0,0"/>

                            <ToggleSwitch x:Name="MinimizeToTrayToggle"
                                          Header="Keep BuildCore running in the hidden-icons area"
                                          IsOn="False"
                                          OffContent="OFF"
                                          OnContent="ON"
                                          Toggled="MinimizeToTrayToggle_Toggled"
                                          Margin="0,12,0,0"/>
                            <TextBlock Text="When enabled, closing the window hides BuildCore in the Windows hidden-icons area instead of exiting the app. Use the tray icon to reopen or exit."
                                       Foreground="#66666D"
                                       FontSize="8"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Padding="20"
                            CornerRadius="14"
                            Background="#101014"
                            BorderBrush="#28282E"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="MAINTENANCE"
                                       Foreground="{StaticResource BuildCoreAccentBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="BuildCore data"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="Reset appearance and interface preferences without deleting optimization snapshots or benchmark history."
                                       Foreground="#77777E"
                                       FontSize="9"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,12"/>
                            <Button x:Name="ResetSettingsButton"
                                    Content="RESET APP SETTINGS"
                                    Click="ResetSettingsButton_Click"
                                    HorizontalAlignment="Left"
                                    Padding="16,10"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,20"
                            Padding="18"
                            CornerRadius="12"
                            Background="#121216"
                            BorderBrush="#25252B"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="BUILDCORE"
                                       Foreground="White"
                                       FontSize="9"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Safe by design. BuildCore uses controlled optimization handlers rather than giving an assistant arbitrary access to Windows commands."
                                       Foreground="#77777E"
                                       FontSize="9"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>

    </Grid>


