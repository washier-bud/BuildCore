<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BuildCore.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="BuildCore">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <!-- Subtle cinematic space layer. Kept behind all interactive UI. -->
        <Canvas
            Grid.ColumnSpan="2"
            IsHitTestVisible="False"
            Opacity="0.72">

            <Ellipse
                x:Name="ParallaxGlowOne"
                Width="620"
                Height="620"
                Canvas.Left="-180"
                Canvas.Top="120"
                Fill="#151519"
                Opacity="0.9"/>

            <Ellipse
                x:Name="ParallaxGlowTwo"
                Width="520"
                Height="520"
                Canvas.Left="760"
                Canvas.Top="520"
                Fill="#111116"
                Opacity="0.85"/>

            <Ellipse
                x:Name="ParallaxRingOne"
                Width="760"
                Height="760"
                Canvas.Left="980"
                Canvas.Top="-160"
                Stroke="#FFFFFF"
                StrokeThickness="1"
                Opacity="0.055"/>

            <Ellipse
                x:Name="ParallaxRingTwo"
                Width="980"
                Height="980"
                Canvas.Left="220"
                Canvas.Top="360"
                Stroke="#FFFFFF"
                StrokeThickness="1"
                Opacity="0.035"/>

            <Ellipse
                Width="3"
                Height="3"
                Canvas.Left="18"
                Canvas.Top="110"
                Fill="White"
                Opacity="0.45"/>

            <Ellipse
                Width="2"
                Height="2"
                Canvas.Left="88"
                Canvas.Top="410"
                Fill="White"
                Opacity="0.35"/>

            <Ellipse
                Width="2"
                Height="2"
                Canvas.Left="340"
                Canvas.Top="170"
                Fill="White"
                Opacity="0.3"/>

            <Ellipse
                Width="2"
                Height="2"
                Canvas.Left="610"
                Canvas.Top="90"
                Fill="White"
                Opacity="0.3"/>

            <Ellipse
                Width="3"
                Height="3"
                Canvas.Left="820"
                Canvas.Top="230"
                Fill="White"
                Opacity="0.4"/>

            <Ellipse
                Width="2"
                Height="2"
                Canvas.Left="1160"
                Canvas.Top="150"
                Fill="White"
                Opacity="0.35"/>

            <Ellipse
                Width="2"
                Height="2"
                Canvas.Left="1320"
                Canvas.Top="520"
                Fill="White"
                Opacity="0.3"/>

        </Canvas>

        <Grid x:Name="BuildCoreContentRoot">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ====================================================== -->
        <!-- SIDEBAR -->
        <!-- ====================================================== -->

        <Border
            Grid.Column="0"
            Background="#0D0D10"
            BorderBrush="#202024"
            BorderThickness="0,0,1,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="110"/>
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="24,0,0,0">

                    <Border
                        Width="42"
                        Height="42"
                        CornerRadius="10"
                        Background="White">

                        <TextBlock
                            Text="B"
                            Foreground="#09090B"
                            FontSize="24"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="BUILDCORE"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="PC PERFORMANCE"
                            Foreground="#66666D"
                            FontSize="8"
                            Margin="0,3,0,0"/>

                    </StackPanel>

                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Margin="14,20,14,0">

                    <Button
                        x:Name="DashboardButton"
                        Click="DashboardButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="⌂"
                                FontSize="17"
                                Foreground="#AAAAAF"
                                Width="28"/>

                            <TextBlock
                                Text="Dashboard"
                                Foreground="#DADADF"
                                FontSize="13"/>

                        </StackPanel>

                    </Button>

                    <Button
                        x:Name="SystemButton"
                        Click="SystemButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="▣"
                                FontSize="15"
                                Foreground="#AAAAAF"
                                Width="28"/>

                            <TextBlock
                                Text="System"
                                Foreground="#DADADF"
                                FontSize="13"/>

                        </StackPanel>

                    </Button>

                    <Button
                        x:Name="PerformanceButton"
                        Click="PerformanceButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="◌"
                                FontSize="17"
                                Foreground="#AAAAAF"
                                Width="28"/>

                            <TextBlock
                                Text="Performance"
                                Foreground="#DADADF"
                                FontSize="13"/>

                        </StackPanel>

                    </Button>

                    <Button
                        x:Name="OptimizeButton"
                        Click="OptimizeButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="#17171C"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="⚡"
                                FontSize="15"
                                Foreground="White"
                                Width="28"/>

                            <TextBlock
                                Text="Optimize"
                                Foreground="White"
                                FontSize="13"
                                FontWeight="SemiBold"/>

                        </StackPanel>

                    </Button>

                    <Button
                        x:Name="HistoryButton"
                        Click="HistoryButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="◷"
                                FontSize="16"
                                Foreground="#AAAAAF"
                                Width="28"/>

                            <TextBlock
                                Text="History"
                                Foreground="#DADADF"
                                FontSize="13"/>

                        </StackPanel>

                    </Button>

                    <Button
                        x:Name="SettingsButton"
                        Click="SettingsButton_Click"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,12"
                        Margin="0,2">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Text="⚙"
                                FontSize="16"
                                Foreground="#AAAAAF"
                                Width="28"/>

                            <TextBlock
                                Text="Settings"
                                Foreground="#DADADF"
                                FontSize="13"/>

                        </StackPanel>

                    </Button>

                </StackPanel>

                <Border
                    Grid.Row="2"
                    Margin="16,10,16,18"
                    Padding="14"
                    CornerRadius="10"
                    Background="#121216">

                    <StackPanel>

                        <StackPanel
                            Orientation="Horizontal">

                            <Ellipse
                                Width="7"
                                Height="7"
                                Fill="#7CFF8A"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Text=" SYSTEM PROTECTED"
                                Foreground="#D8D8DD"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Margin="5,0,0,0"/>

                        </StackPanel>

                        <TextBlock
                            Text="Snapshots enabled"
                            Foreground="#66666D"
                            FontSize="9"
                            Margin="0,7,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- ====================================================== -->
        <!-- MAIN -->
        <!-- ====================================================== -->

        <Grid
            Grid.Column="1">

            <Border
                Height="64"
                VerticalAlignment="Top"
                Background="#0B0B0E"
                BorderBrush="#202024"
                BorderThickness="0,0,0,1">

                <Grid>

                    <TextBlock
                        Text="BuildCore"
                        Foreground="#77777E"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Margin="28,0,0,0"/>

                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Margin="0,0,28,0"
                        VerticalAlignment="Center">

                        <Ellipse
                            Width="7"
                            Height="7"
                            Fill="#7CFF8A"/>

                        <TextBlock
                            Text=" SYSTEM ONLINE"
                            Foreground="#AFAFB5"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Margin="6,0,0,0"/>

                        <TextBlock
                            Text="Performance Dashboard"
                            Foreground="#55555C"
                            FontSize="9"
                            Margin="25,0,0,0"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- ================================================== -->
            <!-- DASHBOARD -->
            <!-- ================================================== -->

            <ScrollViewer
                x:Name="DashboardPage"
                Margin="0,64,0,0"
                VerticalScrollBarVisibility="Auto">

                <StackPanel
                    Padding="32">

                    <TextBlock
                        Text="BUILDCORE"
                        Foreground="#5E5E65"
                        FontSize="10"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="Performance Dashboard"
                        Foreground="White"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Margin="0,4,0,0"/>

                    <Border
                        Margin="0,28,0,0"
                        Padding="22"
                        CornerRadius="14"
                        Background="#111116"
                        BorderBrush="#24242A"
                        BorderThickness="1">

                        <StackPanel>

                            <TextBlock
                                Text="SYSTEM READY"
                                Foreground="#7CFF8A"
                                FontSize="10"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="BuildCore is monitoring your system."
                                Foreground="#A7A7AE"
                                FontSize="12"
                                Margin="0,6,0,0"/>

                        </StackPanel>

                    </Border>

                    <TextBlock
                        Text="HARDWARE"
                        Foreground="#5E5E65"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Margin="0,30,0,12"/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Margin="0,0,7,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#111116">

                            <StackPanel>

                                <TextBlock
                                    Text="CPU"
                                    Foreground="#66666D"
                                    FontSize="9"/>

                                <TextBlock
                                    x:Name="CpuText"
                                    Text="Unknown CPU"
                                    Foreground="White"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Margin="0,8,0,0"/>

                                <TextBlock
                                    x:Name="CpuUsageText"
                                    Text="0%"
                                    Foreground="#7CFF8A"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Margin="0,14,0,0"/>

                                <TextBlock
                                    x:Name="CpuStatusText"
                                    Text="NORMAL"
                                    Foreground="#66666D"
                                    FontSize="8"
                                    Margin="0,3,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border
                            Grid.Column="1"
                            Margin="7,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#111116">

                            <StackPanel>

                                <TextBlock
                                    Text="GPU"
                                    Foreground="#66666D"
                                    FontSize="9"/>

                                <TextBlock
                                    x:Name="GpuText"
                                    Text="Unknown GPU"
                                    Foreground="White"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Margin="0,8,0,0"/>

                                <TextBlock
                                    x:Name="GpuUsageText"
                                    Text="0%"
                                    Foreground="#7CFF8A"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Margin="0,14,0,0"/>

                                <TextBlock
                                    x:Name="GpuUsageSensorText"
                                    Text="GPU usage"
                                    Foreground="#66666D"
                                    FontSize="8"
                                    Margin="0,3,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border
                            Grid.Column="2"
                            Margin="7,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#111116">

                            <StackPanel>

                                <TextBlock
                                    Text="MEMORY"
                                    Foreground="#66666D"
                                    FontSize="9"/>

                                <TextBlock
                                    x:Name="RamText"
                                    Text="Unknown RAM"
                                    Foreground="White"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Margin="0,8,0,0"/>

                                <TextBlock
                                    x:Name="RamUsageText"
                                    Text="0%"
                                    Foreground="#7CFF8A"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Margin="0,14,0,0"/>

                                <TextBlock
                                    x:Name="RamStatusText"
                                    Text="NORMAL"
                                    Foreground="#66666D"
                                    FontSize="8"
                                    Margin="0,3,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border
                            Grid.Column="3"
                            Margin="7,0,0,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#111116">

                            <StackPanel>

                                <TextBlock
                                    Text="STORAGE"
                                    Foreground="#66666D"
                                    FontSize="9"/>

                                <TextBlock
                                    x:Name="StorageText"
                                    Text="Unknown Storage"
                                    Foreground="White"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Margin="0,8,0,0"/>

                                <TextBlock
                                    x:Name="DiskUsageText"
                                    Text="0%"
                                    Foreground="#7CFF8A"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Margin="0,14,0,0"/>

                                <TextBlock
                                    x:Name="DiskStatusText"
                                    Text="NORMAL"
                                    Foreground="#66666D"
                                    FontSize="8"
                                    Margin="0,3,0,0"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <TextBlock
                        Text="LIVE PERFORMANCE"
                        Foreground="#5E5E65"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Margin="0,30,0,12"/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Margin="0,0,7,0"
                            Padding="18"
                            CornerRadius="12"
                            Background="#111116">

                            <StackPanel>

                                <TextBlock
                                    Text="CPU LOAD"
                                    Foreground="#66666D"
                                    FontSize="9"/>

                                <TextBlock
                                    x:Name="CpuPerformanceLarge"
                                    Text="0%"
                                    Foreground="White"
                                    FontSize="30"
                                    FontWeight="SemiBold"
                                    Margin="0,7,0,0"/>

                                <TextBlock
                                    x:Name="CpuTemperatureLarge"
                                    Text="N/A"
                                    Foreground="#7CFF8A"
                                    FontSize="11"
                                    Margin="0,5,0,0"/>

                                <TextBlock
                                    x:Name="CpuTemperatureText"
                                    Text="Sensor unavailable"
                                    Foreground="#66666D"
                                    FontSize="8"
                                    Margin="0,2,0,0"/>

                                <TextBlock
                                    x:Name="CpuClockLarge"
                                    Text="-- GHz"
                                    Foreground="#A0A0A7"
                                    FontSize="11"
                                    Margin="0,8,0,0"/>

                                <TextBlock
                                    x:Name="CpuClockText"
                                    Text="Clock: -- GHz"
                                    Foreground="#66666D"
                                    FontSize="8"
                                    Margin="0,2,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border
                            Grid.Column="1"
                            Margin="7,0"
                            Padding="18"
                            CornerRadius="12"
                            Background="#111116">

                            <StackPanel>

                                <TextBlock
                                    Text="GPU"
                                    Foreground="#66666D"
                                    FontSize="9"/>

                                <TextBlock
                                    x:Name="GpuTemperatureLarge"
                                    Text="N/A"
                                    Foreground="White"
                                    FontSize="30"
                                    FontWeight="SemiBold"
                                    Margin="0,7,0,0"/>

                                <TextBlock
                                    x:Name="GpuClockLarge"
                                    Text="-- MHz"
                                    Foreground="#7CFF8A"
                                    FontSize="11"
                                    Margin="0,5,0,0"/>

                                <TextBlock
                                    x:Name="GpuMemoryLarge"
                                    Text="-- GB"
                                    Foreground="#A0A0A7"
                                    FontSize="11"
                                    Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border
                            Grid.Column="2"
                            Margin="7,0,0,0"
                            Padding="18"
                            CornerRadius="12"
                            Background="#111116">

                            <StackPanel>

                                <TextBlock
                                    Text="MEMORY / STORAGE"
                                    Foreground="#66666D"
                                    FontSize="9"/>

                                <TextBlock
                                    x:Name="RamPerformanceLarge"
                                    Text="0%"
                                    Foreground="White"
                                    FontSize="30"
                                    FontWeight="SemiBold"
                                    Margin="0,7,0,0"/>

                                <TextBlock
                                    Text="Memory usage"
                                    Foreground="#66666D"
                                    FontSize="9"
                                    Margin="0,4,0,0"/>

                                <TextBlock
                                    x:Name="DiskPerformanceLarge"
                                    Text="0%"
                                    Foreground="#7CFF8A"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Margin="0,14,0,0"/>

                                <TextBlock
                                    Text="Disk activity"
                                    Foreground="#66666D"
                                    FontSize="9"
                                    Margin="0,3,0,0"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <TextBlock
                        Text="WINDOWS CONFIGURATION"
                        Foreground="#5E5E65"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Margin="0,30,0,12"/>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Margin="0,0,7,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#111116">

                            <StackPanel>

                                <TextBlock
                                    Text="WINDOWS"
                                    Foreground="#66666D"
                                    FontSize="9"/>

                                <TextBlock
                                    x:Name="WindowsVersionText"
                                    Text="Unknown Windows"
                                    Foreground="White"
                                    FontSize="11"
                                    TextWrapping="Wrap"
                                    Margin="0,8,0,0"/>

                                <TextBlock
                                    x:Name="WindowsBuildText"
                                    Text="Build Unknown"
                                    Foreground="#66666D"
                                    FontSize="9"
                                    Margin="0,5,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border
                            Grid.Column="1"
                            Margin="7,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#111116">

                            <StackPanel>

                                <TextBlock
                                    Text="POWER PLAN"
                                    Foreground="#66666D"
                                    FontSize="9"/>

                                <TextBlock
                                    x:Name="PowerPlanText"
                                    Text="Unknown"
                                    Foreground="White"
                                    FontSize="11"
                                    Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border
                            Grid.Column="2"
                            Margin="7,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#111116">

                            <StackPanel>

                                <TextBlock
                                    Text="GAME MODE"
                                    Foreground="#66666D"
                                    FontSize="9"/>

                                <TextBlock
                                    x:Name="GameModeText"
                                    Text="Unknown"
                                    Foreground="White"
                                    FontSize="11"
                                    Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border
                            Grid.Column="3"
                            Margin="7,0,0,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#111116">

                            <StackPanel>

                                <TextBlock
                                    Text="HAGS"
                                    Foreground="#66666D"
                                    FontSize="9"/>

                                <TextBlock
                                    x:Name="HagsText"
                                    Text="Unknown"
                                    Foreground="White"
                                    FontSize="11"
                                    Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <Grid
                        Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Margin="0,0,7,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#111116">

                            <StackPanel>

                                <TextBlock
                                    Text="MEMORY INTEGRITY"
                                    Foreground="#66666D"
                                    FontSize="9"/>

                                <TextBlock
                                    x:Name="MemoryIntegrityText"
                                    Text="Unknown"
                                    Foreground="White"
                                    FontSize="11"
                                    Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border
                            Grid.Column="1"
                            Margin="7,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#111116">

                            <StackPanel>

                                <TextBlock
                                    Text="DEFENDER"
                                    Foreground="#66666D"
                                    FontSize="9"/>

                                <TextBlock
                                    x:Name="DefenderText"
                                    Text="Unknown"
                                    Foreground="White"
                                    FontSize="11"
                                    Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border
                            Grid.Column="2"
                            Margin="7,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#111116">

                            <StackPanel>

                                <TextBlock
                                    Text="GAME BAR"
                                    Foreground="#66666D"
                                    FontSize="9"/>

                                <TextBlock
                                    x:Name="GameBarText"
                                    Text="Unknown"
                                    Foreground="White"
                                    FontSize="11"
                                    Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                        <Border
                            Grid.Column="3"
                            Margin="7,0,0,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#111116">

                            <StackPanel>

                                <TextBlock
                                    Text="WINDOWS UPDATE"
                                    Foreground="#66666D"
                                    FontSize="9"/>

                                <TextBlock
                                    x:Name="WindowsUpdateText"
                                    Text="Unknown"
                                    Foreground="White"
                                    FontSize="11"
                                    TextWrapping="Wrap"
                                    Margin="0,8,0,0"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <Border
                        Margin="0,10,0,0"
                        Padding="16"
                        CornerRadius="12"
                        Background="#111116">

                        <StackPanel>

                            <TextBlock
                                Text="PROCESSOR"
                                Foreground="#66666D"
                                FontSize="9"/>

                            <TextBlock
                                x:Name="ProcessorText"
                                Text="Unknown"
                                Foreground="White"
                                FontSize="11"
                                Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,25,0,30">

                        <Button
                            x:Name="ScanWindowsButton"
                            Click="ScanWindowsButton_Click"
                            Content="SCAN WINDOWS"
                            Padding="22,11"/>

